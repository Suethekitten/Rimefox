{
  "manifest_version": 3,
  "name": "DualTrans 双语对照翻译",
  "version": "0.4.5",
  "description": "自己的 API，自己的翻译引擎：整页双语对照翻译、动态内容补翻、多主题显示。",
  "minimum_chrome_version": "114",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "双语翻译",
    "default_popup": "popup/index.html"
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-translate": {
      "suggested_key": {
        "default": "Alt+A"
      },
      "description": "翻译 / 还原当前页面"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/core.js",
        "content/dom.js",
        "content/main.js"
      ],
      "css": ["content/styles/inject.css"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": false
    }
  ]
}
