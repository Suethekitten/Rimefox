# 依赖与构建产物（本项目零构建，理论上不会产生）
node_modules/
dist/

# 打包产物
*.zip
# 例外：随仓库提交、由 Release 工作流校验后自动附加的 OCR 组件（见 tools/ocr-release-assets.mjs）
!release-assets/ocr/*.zip

# 编辑器与系统文件
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.log

# 本地环境变量（如果把 Key 写进配置时用）
.env
.env.*

# 签名私钥 / 证书：任何情况下都不进仓库
*.pem
*.key
*.crx
*.p12
*.pfx

# real PDFs for the stage-0 probe (downloaded locally, not committed)
reader/pdf-real/

# OCR 参考宿主在本机生成的清单与启动脚本
tools/ocr-mock-host/.local/

# macOS OCR 连接器构建产物
native/ocr-host/macos/build/

# Windows OCR 连接器构建产物
native/ocr-host/windows/build/
native/ocr-host/windows/bin/
native/ocr-host/windows/obj/
